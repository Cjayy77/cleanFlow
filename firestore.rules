rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Un rôle ne compte que si le compte a été approuvé par un admin.
    // (Les documents créés avant l'ajout du champ accountStatus sont
    // considérés approuvés.)
    function hasRole(role) {
      return isSignedIn()
        && userData().role == role
        && userData().get('accountStatus', 'approved') == 'approved';
    }

    function isClient() {
      return hasRole('client');
    }

    function isPrestataire() {
      return hasRole('prestataire');
    }

    function isLivreur() {
      return hasRole('livreur');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // Auto-inscription : les clients naissent approuvés ; les rôles
      // prestataire/livreur/admin naissent en 'pending' et n'ont aucun
      // droit tant qu'un admin ne les a pas approuvés dans /admin/.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (
          (request.resource.data.role == 'client'
            && request.resource.data.accountStatus == 'approved')
          || (request.resource.data.role in ['prestataire', 'livreur', 'admin']
            && request.resource.data.accountStatus == 'pending')
        );
      allow update: if isSignedIn() && (
        // Soi-même : profil modifiable, mais ni uid, ni rôle, ni statut.
        (request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('accountStatus', 'approved') == resource.data.get('accountStatus', 'approved'))
        // Admin : décision d'accès uniquement (approuver ou refuser).
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountStatus'])
          && request.resource.data.accountStatus in ['approved', 'rejected'])
      );
    }

    match /properties/{propertyId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if isClient()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.street is string
        && request.resource.data.city is string
        && request.resource.data.postalCode is string;
      allow update, delete: if isClient() && resource.data.ownerId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      // Les requêtes de liste côté app filtrent toujours sur un seul champ
      // (clientId / prestataireId / status=='pending' / linenRequested), ce qui
      // rend chaque branche ci-dessous prouvable par Firestore.
      allow read: if isSignedIn() && (
        isAdmin()
        || (isClient() && resource.data.clientId == request.auth.uid)
        || (isPrestataire() && (resource.data.prestataireId == request.auth.uid || resource.data.status == 'pending'))
        || (isLivreur() && resource.data.linenRequested == true)
      );

      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.prestataireId == null
        && ((request.resource.data.serviceType == 'normal' && request.resource.data.price == 47)
            || (request.resource.data.serviceType == 'deep' && request.resource.data.price == 60))
        && request.resource.data.scheduledDate is string
        && request.resource.data.linenRequested is bool
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId == request.auth.uid;

      allow update: if isSignedIn() && (
        // Client : annuler sa réservation tant qu'aucun prestataire ne l'a acceptée.
        (isClient()
          && resource.data.clientId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Prestataire : accepter une mission en attente…
        || (isPrestataire()
          && resource.data.status == 'pending'
          && resource.data.prestataireId == null
          && request.resource.data.status == 'accepted'
          && request.resource.data.prestataireId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'prestataireId']))
        // …ou soumettre / re-soumettre son propre dossier.
        || (isPrestataire()
          && resource.data.prestataireId == request.auth.uid
          && resource.data.status in ['accepted', 'rejected']
          && request.resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Admin : verdict de vérification uniquement.
        || (isAdmin()
          && request.resource.data.status in ['verified', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNote', 'verifiedBy', 'verifiedAt']))
      );
    }

    match /photos/{photoId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (isPrestataire() && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.prestataireId == request.auth.uid)
        || (isClient() && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.clientId == request.auth.uid)
      );
      // create + update : re-téléverser un emplacement remplace la photo
      // précédente (dossier rejeté à corriger).
      allow create, update: if isPrestataire()
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.verified == false
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.prestataireId == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.verified == true
        && request.resource.data.verifiedBy == request.auth.uid;
    }

    // File d'envoi d'e-mails, consommée par l'extension « Trigger Email »
    // (qui utilise le SDK Admin et ignore ces règles). Un utilisateur
    // connecté ne peut écrire qu'à l'adresse de l'équipe ; seul un admin
    // peut notifier une autre adresse (client, prestataire).
    match /mail/{mailId} {
      allow read, update, delete: if false;
      allow create: if isSignedIn()
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string
        && (isAdmin() || request.resource.data.to == 'william@cleanflow-app.com');
    }

    match /incidents/{incidentId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (isPrestataire() && resource.data.reportedBy == request.auth.uid)
      );
      allow create: if isPrestataire()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.type in ['broken_object', 'lost_object', 'other']
        && request.resource.data.status == 'open';
      allow update: if isAdmin();
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Les règles Storage lisent Firestore via firestore.get (règles
    // inter-services) pour vérifier le rôle et l'affectation de la mission.
    // Un compte non approuvé n'a aucun rôle effectif.
    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('accountStatus', 'approved') == 'approved'
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : 'none';
    }

    match /bookings/{bookingId}/{filePath=**} {
      function bookingData() {
        return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
      }

      allow read: if request.auth != null && (
        userRole() == 'admin'
        || (userRole() == 'prestataire' && bookingData().prestataireId == request.auth.uid)
        || (userRole() == 'client' && bookingData().clientId == request.auth.uid)
      );

      allow write: if request.auth != null
        && userRole() == 'prestataire'
        && bookingData().prestataireId == request.auth.uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /incidents/{bookingId}/{filePath=**} {
      allow read: if request.auth != null && userRole() == 'admin';
      allow write: if request.auth != null
        && userRole() == 'prestataire'
        && firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.prestataireId == request.auth.uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Photos du catalogue (kits, consommables…) : visibles par les utilisateurs
    // connectés (le client les voit), déposées par l'équipe CleanFlow.
    match /catalog/{filePath=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && userRole() == 'admin'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Photos de contrôle du Welcomer, déposées sur place. Le Welcomer assigné
    // écrit ; admin, client concerné et Welcomer assigné peuvent lire.
    match /welcomer/{bookingId}/{filePath=**} {
      function bk() { return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data; }
      allow read: if request.auth != null && (
        userRole() == 'admin'
        || (userRole() == 'welcomer' && bk().get('welcomerId', '') == request.auth.uid)
        || (userRole() == 'client' && bk().clientId == request.auth.uid)
      );
      allow write: if request.auth != null
        && userRole() == 'welcomer'
        && bk().get('welcomerId', '') == request.auth.uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}

// Rétention des photos : suppression manuelle après 90 jours (processus
// documenté dans SETUP.md — pas de Cloud Function pour la bêta).

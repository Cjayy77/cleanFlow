rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Les règles Storage lisent Firestore via firestore.get (règles
    // inter-services) pour vérifier le rôle et l'affectation de la mission.
    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    match /bookings/{bookingId}/{filePath=**} {
      function bookingData() {
        return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
      }

      allow read: if request.auth != null && (
        userRole() == 'admin'
        || (userRole() == 'prestataire' && bookingData().prestataireId == request.auth.uid)
        || (userRole() == 'client' && bookingData().clientId == request.auth.uid)
      );

      allow write: if request.auth != null
        && userRole() == 'prestataire'
        && bookingData().prestataireId == request.auth.uid;
    }

    match /incidents/{bookingId}/{filePath=**} {
      allow read: if request.auth != null && userRole() == 'admin';
      allow write: if request.auth != null && userRole() == 'prestataire';
    }
  }
}

// Rétention des photos : suppression manuelle après 90 jours (processus
// documenté dans SETUP.md — pas de Cloud Function pour la bêta).
